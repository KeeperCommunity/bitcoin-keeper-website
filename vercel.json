{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(ask|learn)/?",
      "status": 308,
      "headers": { "Location": "/ask-keeper" }
    },
    {
      "src": "/hc(/.*)?",
      "status": 308,
      "headers": { "Location": "https://www.bitcoinkeeper.app/ask-keeper" }
    },
    {
      "src": "/team/?",
      "status": 308,
      "headers": { "Location": "/contributors" }
    },
    {
      "src": "/private/?",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/desktop/?",
      "status": 308,
      "headers": { "Location": "https://github.com/KeeperCommunity/keeper-desktop/releases" }
    },
    {
      "src": "/(features|contributors|ask-keeper|privacy-policy|terms-of-service)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
